# ============================================================
#  ŞABLON — bunu kopyalayıp ".env" adıyla kaydet, sonra şifreyi
#  kendi seçtiğinle değiştir.
#
#      copy .env.example .env
#
#  ⚠️ .env repoya GİRMİYOR (.gitignore'da). Gerçek şifre yalnızca
#  senin makinende duruyor. appsettings.Development.json'daki JWT
#  anahtarıyla aynı mantık.
#
#  ⚠️ docker-compose.yml bu dosyayı KENDİLİĞİNDEN okuyor — komutta
#  ayrıca belirtmen gerekmiyor. Yeter ki compose dosyasıyla aynı
#  klasörde olsun.
# ============================================================

# SQL Server'ın "sa" (yönetici) kullanıcısının şifresi.
#
# ⚠️ SQL Server ŞİFRE KURALI DAYATIYOR, sağlamazsan container
# açılmıyor ve günlükte "Password validation failed" yazıyor:
#   • en az 8 karakter
#   • büyük harf + küçük harf + rakam + sembol (dördü birden)
#
# ⚠️ Şifrede $ karakteri KULLANMA — compose onu değişken sanıp
# yerine başka bir şey koymaya çalışıyor.
MSSQL_SA_PASSWORD=BurayaGucluBirSifre1!


# JWT imzalama anahtarı — token'ları bu imzalıyor.
#
# ⚠️ appsettings.Development.json'daki "Jwt:Key" ile AYNI değeri
# yaz. Farklı olursa `dotnet run` ile alınmış token konteyner
# API'sinde geçersiz olur (ve tersi) — "neden 401 alıyorum"
# sorusunun sinsi cevabı budur.
#
# ⚠️ Yeni bir anahtar üretmek istersen (PowerShell):
#   [Convert]::ToBase64String((1..64|%{Get-Random -Max 256}))
# ⚠️ Anahtarı değiştirmek MEVCUT TÜM TOKEN'LARI geçersizler —
# herkes yeniden giriş yapar. Sızıntı şüphesi dışında dokunma.
JWT_KEY=BurayaBase64BirAnahtar==


# API'nin kendi dış adresi — e-posta doğrulama linki buraya işaret eder.
#
# ⚠️ Boş bırakırsan http://localhost:5289 varsayılıyor. Bu yalnızca
# BU BİLGİSAYARDA doğru: telefondan kayıt olan biri linke tıklayınca
# kendi telefonuna bakar ve hiçbir yere ulaşamaz. Alan adı/tünel
# adresi gelince (Adım 3) burası güncellenmeli.
API_TABAN_URL=http://localhost:5289


# Admin panelin dis adresi — SIFRE SIFIRLAMA linki buraya isaret eder.
#
# ⚠️ Bos birakirsan http://localhost:5173 varsayiliyor ve sifre
# sifirlama maili disaridan calismaz: link tiklayanin kendi
# bilgisayarina bakar.
#
# ⚠️ Genelde API_TABAN_URL ile AYNI adres yazilir, yazim hatasi degil:
# Caddy admin panelini ayni adresin kokunden sunuyor.
PANEL_URL=http://localhost:5173


# ============================================================
#  E-POSTA (Brevo)
# ============================================================
#
# "konsol" = mail gondermez, konteyner gunlugune basar (varsayilan)
# "brevo"  = gercekten gonderir
#
# ⚠️ "brevo" secip anahtari bos birakirsan API ACILMAZ. Sessizce
# konsola dusup "mail gitti" sanmaktansa patlamasi bilincli.
EMAIL_SAGLAYICI=konsol


# Brevo API anahtari (SMTP & API -> API Keys -> v3).
#
# ⚠️ Bu deger repoya GIRMEZ; gercek .env dosyasi gitignore'da.
BREVO_API_ANAHTARI=


# Gonderen e-posta adresi.
#
# ⚠️ Brevo panelinde DOGRULANMIS olmak zorunda (Senders bolumu,
# adrese gelen onay linkine tiklayarak). Alan adi gerekmiyor.
EMAIL_GONDEREN_ADRES=


# ⚠️⚠️ GUVENLIK VALFI — GELISTIRMEDE DOLDUR, CANLIDA BOS BIRAK.
#
# Doluysa TUM mailler bu adrese gider, gercek alici konunun basina
# yazilir. Veritabanindaki test kullanicilarinin bir kismi GERCEK
# adresler; eski bir test siparisinin durumunu degistirmek
# tanimadigimiz birine "siparisiniz kargoya verildi" maili yollardi.
EMAIL_YONLENDIR=


# Admin panelin tarayicida acildigi adresler (virgulle ayrilmis).
#
# ⚠️ Yalnizca Production'da kullaniliyor; Development'ta CORS serbest.
# ⚠️ Liste eksikse admin panel SESSIZCE calismaz — istek gider, tarayici
# cevabi bloklar ve konsolda CORS hatasi cikar.
CORS_ORIGINLERI=http://localhost:5173


# Ortam. Varsayilan Production.
# ⚠️ Development'a almak /openapi/v1.json'i ve ham hata mesajlarini
# disariya acar — Funnel aciksa bunlar internetten okunabilir.
ASPNET_ORTAM=Production


# ============================================================
#  ODEME (iyzico Checkout Form)
# ============================================================
#
# "simulasyon" = iyzico'ya cikmaz, odemeyi basarili sayar (varsayilan)
# "iyzico"     = gercek sandbox akisi (3DS dahil)
#
# ⚠️ "iyzico" secip anahtarlari bos birakirsan API ACILMAZ — sessizce
# odemeyi sahte gecmektense patlamasi bilincli.
#
# ⚠️ Anahtarlar "sandbox-" ile baslamak ZORUNDA. Canli anahtarin
# gelistirme makinesine dusmesi gercek para demek.
#
# Anahtarlarin yeri: sandbox-merchant.iyzipay.com -> Ayarlar ->
# Firma Ayarlari -> API Keys
ODEME_SAGLAYICI=simulasyon
IYZICO_API_ANAHTARI=
IYZICO_GIZLI_ANAHTAR=
IYZICO_TABAN_URL=https://sandbox-api.iyzipay.com
