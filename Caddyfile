# ============================================================
#  ADIM 3 — TERS VEKİL + ADMIN PANEL
#
#  Caddy iki iş yapıyor:
#    1) Gerçek istemci IP'sini API'ye taşımak (PROXY → X-Forwarded-For)
#    2) Admin paneli (statik React çıktısı) sunmak
#
#  ⚠️ Panel ve API AYNI adresten çıkıyor. Bunun bedava kazancı:
#  tarayıcı için origin aynı olduğundan CORS hiç devreye girmiyor ve
#  panelin paketinde gömülü sunucu adresi yok — adres değişince
#  yeniden derlemek gerekmiyor.
#
#  TLS'i Tailscale Funnel sonlandırıyor, Caddy sertifika almıyor.
# ============================================================

{
	auto_https off

	# ⚠️ proxy_protocol YALNIZCA 9899'da.
	# 5289'a da koysaydık LAN'dan gelen normal istekler PROXY başlığı
	# beklenirken 2 saniye takılırdı.
	servers :9899 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s

				# ⚠️ Funnel'ın IP'si değil, DOCKER AĞ GEÇİDİ.
				# Yayımlanan portta kaynak adres yeniden yazıldığı için
				# başlığı gönderen taraf Caddy'ye 172.x görünüyor;
				# gerçek istemci adresi başlığın İÇİNDE geliyor.
				allow 172.16.0.0/12
			}
		}
	}
}

# İki dinleyici de aynı işi yaptığı için kural tek yerde duruyor.
# ⚠️ Sıra önemli: en genel olan "handle" EN SONA kalmalı, yoksa
# /api istekleri de statik dosya olarak aranır.
(uygulama) {
	# Paket 925 KB; sıkıştırma telefonda hissedilir fark yaratıyor.
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle /uploads/* {
		reverse_proxy api:8080
	}

	# ⚠️ Şu an 401 dönüyor (IsLoopback konteynerde anlamsızlaştı).
	# Yine de yönlendiriyoruz: gerçek kimlik doğrulama eklenince
	# burada bir şey değişmesin diye.
	handle /hangfire* {
		reverse_proxy api:8080
	}

	# Geri kalan her şey admin panel.
	handle {
		root * /srv/panel

		# ⚠️ SPA FALLBACK — react-router BrowserRouter kullanıyor.
		# /urunler gibi adresler diskte dosya değil; bulunamayanı
		# index.html'e düşürmezsek sayfa yenilendiğinde 404 gelir.
		try_files {path} /index.html
		file_server
	}
}

# ---- LAN / geliştirme girişi ----
:5289 {
	import uygulama
}

# ---- Funnel girişi ----
# `tailscale funnel --bg --proxy-protocol=2 --tls-terminated-tcp=443
#  tcp://127.0.0.1:9899` bu porta bağlanıyor.
:9899 {
	import uygulama
}
