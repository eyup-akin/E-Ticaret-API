{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=ETicaretRealDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "SET_IN_USER_SECRETS",
    "Issuer": "ETicaretAPI",
    "Audience": "ETicaretApp"
  },
  "Uygulama": {
    // Backend'in kendi adresi — verify-email linki buraya işaret eder,
    // çünkü o GERÇEK bir endpoint (GET /api/auth/verify-email).
    "TabanUrl": "http://localhost:5289",

    // Admin panelin (React/Vite) adresi — sifre-yenile linki buraya gider,
    // çünkü o bir React SAYFASI, backend'de karşılığı yok.
    "PanelUrl": "http://10.119.5.1:5173"
  },
  // Raporlarda gün sınırının hangi saat dilimine göre hesaplanacağı.
  //
  // Veritabanında tarihler UTC saklanıyor (doğru karar), ama
  // "5 Ağustos'ta kaç sipariş aldık" sorusunun cevabı TÜRKİYE
  // gününe göre verilmeli. Türkiye UTC+3 olduğu için gece
  // 00:00-03:00 arası siparişler UTC'de bir önceki güne düşüyor.
  //
  // Neden koda gömmüyoruz:
  //   • Yaz saati uygulaması geri gelirse burada tek satır değişir
  //   • Başka bir ülkeye açılırsanız kod değişmez
  //   • Sabit "+3" yazmak, neden 3 olduğunu kimsenin bilmediği bir
  //     sihirli sayı bırakırdı
  //
  // "Turkey Standard Time" Windows'un ID'si. Linux'ta karşılığı
  // "Europe/Istanbul" — .NET 6+ ikisini de her platformda çözebilir,
  // ama sunucu Linux'a taşınırsa burayı kontrol et.
  "SaatDilimi": "Turkey Standard Time",
  "Magaza": {
    "Ad": "E-Ticaret Mağazası",
    "Telefon": "0850 000 00 00",
    "Adres": "Örnek Mah. Örnek Cad. No:1, Konak / İzmir"
  },
  "Kargo": {
    // Admin panelindeki "Kargoya Ver" modalında seçilebilecek firmalar.
    // Sunucu, gelen firma adının bu listede olup olmadığını da kontrol
    // eder — yani bu liste sadece görsel bir menü değil, bir beyaz liste.
    // Yeni firma eklemek için sadece buraya bir satır yazmak yeterli.
    "Firmalar": [
      "Yurtiçi Kargo",
      "Aras Kargo",
      "MNG Kargo",
      "PTT Kargo",
      "Sürat Kargo"
    ]
  },
  "Basvuru": {
    "RedSonrasiBeklemeSaati": 3
  },
  "Cors": {
    "AllowedOrigins": [ "https://admin.senindomainin.com" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}